#!/bin/sh
# Pre-commit guard for the jobs-finder toolkit.
#
# Blocks a commit when:
#   1. any path under the private overlay (private/) is STAGED, or
#   2. the leak guard finds a violation in the STAGED INDEX content
#      (automation/publish/check_public.py --staged), or
#   3. the published tree changed without a review row in
#      automation/publish/review_ledger.yaml (automation/publish/review_gate.py), or
#   4. a vendored copy has drifted from its canonical source
#      (see automation/vendoring/sync_vendored.py + .../job-search/scripts/_vendor/), or
#   5. any mail provider folder or the email-assistant CLI exposes email-sending
#      capability (folder-walking check: automation/shared/mail/check_mail_safety.py), or
#   6. any toolkit/skill Python file fails to byte-compile.
#
# Checks 1-3 run FIRST because a leak is the only failure here that is not
# reversible by fixing the working tree: once the blob is in a commit it is in the
# history. They have NO env-var escape hatch by design (see AGENTS.md).
#
# Install once (tracked, no git-config change):
#   ln -sf ../../automation/hooks/pre-commit .git/hooks/pre-commit
#
# Bypass in an emergency with:  git commit --no-verify
set -e

# ── 1. Staged private/ overlay paths (no interpreter needed) ─────────────────
# `git add -f private/` — WITH the trailing slash — stages the overlay with exit 0
# and NO output (the slash-less form at least warns), which makes the most
# damaging mistake in this repo also the quietest one. Deletions are excluded
# (--diff-filter) so REMOVING an already-committed private path stays possible.
staged_private="$(git diff --cached --name-only --diff-filter=ACMRT | grep '^private/' || true)"
if [ -n "$staged_private" ]; then
    echo "pre-commit: REFUSING commit — private overlay path(s) are STAGED:" >&2
    printf '%s\n' "$staged_private" | while IFS= read -r p; do echo "    $p" >&2; done
    echo "pre-commit: private/ is the git-ignored mount of the PRIVATE overlay repo;" >&2
    echo "pre-commit: its contents must never enter this public repo's history." >&2
    echo "pre-commit: unstage them with:  git restore --staged private/" >&2
    echo "pre-commit: (commit them inside the overlay: cd private && git add ...)" >&2
    exit 1
fi

# Resolve a Python interpreter, worktree-aware:
#   1. the repo venv at CWD (primary checkout — behavior unchanged);
#   2. the primary checkout's venv via the git common dir (a worktree has no local .venv);
#   3. a system python3/python, but only if it meets the 3.11 floor (CI uses 3.12).
PY=".venv/bin/python"
if [ ! -x "$PY" ]; then
    PY=""
    # In a worktree, .git is a file and the real repo (with its .venv) is the common dir.
    # --git-common-dir output may be absolute or relative to CWD; both resolve here.
    common_dir="$(git rev-parse --git-common-dir 2>/dev/null || true)"
    if [ -n "$common_dir" ] && [ -x "$common_dir/../.venv/bin/python" ]; then
        PY="$common_dir/../.venv/bin/python"
    fi
fi
if [ -z "$PY" ]; then
    # No venv anywhere: accept a system interpreter only if it is >= 3.11.
    for cand in python3 python; do
        p="$(command -v "$cand" 2>/dev/null)" || continue
        if "$p" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
            PY="$p"
            break
        fi
    done
fi
if [ -z "$PY" ]; then
    sys_py="$(command -v python3 || command -v python || true)"
    if [ -n "$sys_py" ]; then
        ver="$("$sys_py" -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null || echo '?')"
        echo "pre-commit: repo requires Python 3.11+; found $ver at $sys_py." >&2
    else
        echo "pre-commit: repo requires Python 3.11+; no python interpreter found." >&2
    fi
    echo "pre-commit: create a .venv (python3.11 -m venv .venv) or point the hook at a 3.11+ interpreter." >&2
    exit 1
fi

# ── 2. Leak guard over the STAGED INDEX ──────────────────────────────────────
# Scans blob content read out of the index, not the worktree: an unstaged edit
# must neither hide a leak that is being committed nor fail a commit that does
# not contain it. --allow-unarmed keeps a contributor clone (no config.yaml, so no
# identity tokens) able to commit while still running the token-INDEPENDENT
# checks; the hard stop for an unarmed guard is at PUSH time (automation/hooks/
# pre-push), where publication actually happens.
echo "pre-commit: leak guard over the staged index..."
"$PY" automation/publish/check_public.py --staged --allow-unarmed

# ── 3. Public review gate ────────────────────────────────────────────────────
# Fails when the published tree changed without a row in
# automation/publish/review_ledger.yaml. It reads HEAD (the PREVIOUS commit) and
# the WORKING-TREE ledger, so the way to satisfy it is to stage the row for HEAD
# alongside the change you are making now — one row per commit, always one
# behind. The gate prints the exact row when it fails. It is SILENT on a pass —
# except for listing any ledger row that a rebase moved out of this history, which
# it skips rather than fails on — and a no-op in a checkout whose history the ledger
# does not describe (an exported mirror), so a public clone's own pre-commit stays green.
# Default run: bounded ledger-integrity tail (~tens of ms). CI runs --verify-all.
echo "pre-commit: public review gate..."
"$PY" automation/publish/review_gate.py

echo "pre-commit: checking vendored copies are in sync..."
"$PY" automation/vendoring/sync_vendored.py --check

echo "pre-commit: enforcing mail send-less policy (folder-walking)..."
"$PY" automation/shared/mail/check_mail_safety.py \
    --consumer skills/email-assistant/scripts

echo "pre-commit: byte-compiling automation + self-contained skills..."
"$PY" -m compileall -q automation \
    skills/job-search/scripts \
    skills/resume-writer/scripts \
    skills/application-tracker/scripts \
    skills/email-assistant/scripts

# Instruction-file token-budget check — a hard gate: every instruction file
# is within budget today, and any commit that pushes one over must slim it.
echo "pre-commit: instruction-file budget (strict)..."
"$PY" automation/metrics/instruction_budget.py --strict

# Reconciler. Every check inside it NO-OPS when its folder is absent — deliberate,
# because the published export ships none of message-queue/, tasks/, memory/,
# roadmap/, history/, and closing that would turn the exported repo's CI red.
# --require-roots is the maintainer-checkout opposite: assert the roots are all
# here, so a botched move cannot quietly disarm a check. A mounted private/
# overlay is the maintainer signal — an exported clone has none, and gets the
# plain (still-correct) run. Never wire --require-roots into CI.
if [ -d private ]; then
    echo "pre-commit: reconciler (process-layer schemas; roots required)..."
    "$PY" automation/reconcile/reconcile.py --check --require-roots
else
    echo "pre-commit: reconciler (process-layer schemas)..."
    "$PY" automation/reconcile/reconcile.py --check
fi

echo "pre-commit: OK"
