#!/bin/sh
# Pre-push leak guard for the jobs-finder toolkit.
#
# Repo model (post-split): this is the PUBLIC toolkit repo. Personal data lives
# in a separate private overlay repo mounted (git-ignored) at ./private/, so the
# TRACKED tree here must always be publishable. This hook enforces that at push
# time:
#
#   1. Remote-visibility gate. Look at the push destination:
#        * GitHub remote + gh confirms PUBLIC   -> run the content leak guard
#          (automation/publish/check_public.py), which must be ARMED with real
#          identity tokens (a real config.yaml or $JOBHUNT_PERSONAL_TOKENS). Guard
#          fails, OR is unarmed (exit 2) -> REFUSE the push: a guard that cannot
#          see the owner's identity cannot certify a tree as publishable.
#        * GitHub remote + gh confirms PRIVATE  -> allow without the guard (a
#          private destination can hold anything; this also covers the private
#          overlay repo).
#        * GitHub remote + gh missing/errors    -> cannot verify; treat like an
#          unknown remote and run the guard as a safety net.
#        * Non-GitHub remote                    -> same: run the guard.
#
#   2. The guard is the gate, not the visibility itself: a clean tracked tree is
#      safe to push anywhere; a dirty one is refused everywhere we cannot prove
#      the destination private.
#
# Manual override (reported loudly):  JOBHUNT_ALLOW_PUSH=1 git push ...
#   FOR THE REPO OWNER ONLY — never for an AGENT, and the strongest case of that rule in
#   the repo: this variable skips BOTH the content leak guard and the refusal to push
#   while the guard is unarmed, so it is the one line here that can put private bytes on
#   a public remote. AGENTS.md forbids an agent bypassing a gate, and
#   evals/canaries/github-workflow.yaml scores "suggests JOBHUNT_ALLOW_PUSH" as a canary
#   FAILURE mode — i.e. an agent must not even propose it. There is no contradiction
#   between that and this hook offering it: the escape hatch exists for the human who
#   installed these hooks, and it must never be reached for by anything else. An agent
#   whose push is refused fixes the finding, or arms the guard, or stops.
#   (It is also NOT the leak guard's documented interface: docs/handbook/private-overlay.md
#   mentions it in one parenthetical and nothing else does.)
#
# Install once (tracked, no git-config change):
#   .venv/bin/python automation/bootstrap_overlay.py     # or:
#   ln -sf ../../automation/hooks/pre-push .git/hooks/pre-push
#
# Bypass in an emergency with:  git push --no-verify
#   Same audience rule as JOBHUNT_ALLOW_PUSH above: owner, at a terminal, never an agent.
#   AGENTS.md ("never bypass with --no-verify") and skills/github-workflow/SKILL.md
#   ("Never --no-verify") both forbid agent use outright.
set -e

remote_name="$1"
remote_url="$2"

if [ "${JOBHUNT_ALLOW_PUSH:-}" = "1" ]; then
    echo "pre-push: JOBHUNT_ALLOW_PUSH=1 set — manual override. SKIPPING, specifically:" >&2
    echo "pre-push:   * the content leak guard (paths, tokens, structural PII," >&2
    echo "pre-push:     private-skill/overlay trees, unscannable binaries), AND" >&2
    echo "pre-push:   * the refusal to push while the guard is UNARMED — i.e. nothing" >&2
    echo "pre-push:     verified that this tree carries no real identity." >&2
    echo "pre-push: you are pushing WITHOUT the leak guard. Be certain this is intended." >&2
    exit 0
fi

# ── 1. Remote-visibility gate ────────────────────────────────────────────────
# Parse "<owner>/<repo>" out of common GitHub remote URL shapes:
#   git@github.com:owner/repo(.git)
#   https://github.com/owner/repo(.git)
#   ssh://git@github.com/owner/repo(.git)
owner_repo=""
case "$remote_url" in
    *github.com[:/]*)
        owner_repo=$(printf '%s\n' "$remote_url" \
            | sed -E 's#^.*github\.com[:/]+##; s#\.git$##; s#/$##')
        ;;
esac

# run_guard: yes | no
run_guard="yes"

if [ -n "$owner_repo" ]; then
    if command -v gh >/dev/null 2>&1; then
        is_private=$(gh repo view "$owner_repo" --json isPrivate --jq '.isPrivate' 2>/dev/null || echo "")
        case "$is_private" in
            true)
                echo "pre-push: remote '$owner_repo' is PRIVATE (verified via gh) — allowing without the guard."
                run_guard="no"
                ;;
            false)
                echo "pre-push: remote '$owner_repo' is PUBLIC — running the content leak guard."
                ;;
            *)
                echo "pre-push: WARNING — could not verify visibility of '$owner_repo' via gh" >&2
                echo "pre-push: (no auth / network?). Running the content leak guard as a safety net." >&2
                ;;
        esac
    else
        echo "pre-push: WARNING — 'gh' not found; cannot verify visibility of '$owner_repo'." >&2
        echo "pre-push: Running the content leak guard as a safety net (install gh to skip on private remotes)." >&2
    fi
else
    echo "pre-push: WARNING — non-GitHub remote '$remote_name' ($remote_url); cannot verify" >&2
    echo "pre-push: its visibility. Running the content leak guard as a safety net." >&2
fi

# ── 2. Content leak guard ────────────────────────────────────────────────────
if [ "$run_guard" = "no" ]; then
    echo "pre-push: OK"
    exit 0
fi

# Resolve a Python interpreter, worktree-aware:
#   1. the repo venv at CWD (primary checkout — behavior unchanged);
#   2. the primary checkout's venv via the git common dir (a worktree has no local .venv);
#   3. a system python3/python, but only if it meets the 3.11 floor (CI uses 3.12).
PY=".venv/bin/python"
if [ ! -x "$PY" ]; then
    PY=""
    # In a worktree, .git is a file and the real repo (with its .venv) is the common dir.
    # --git-common-dir output may be absolute or relative to CWD; both resolve here.
    common_dir="$(git rev-parse --git-common-dir 2>/dev/null || true)"
    if [ -n "$common_dir" ] && [ -x "$common_dir/../.venv/bin/python" ]; then
        PY="$common_dir/../.venv/bin/python"
    fi
fi
if [ -z "$PY" ]; then
    # No venv anywhere: accept a system interpreter only if it is >= 3.11.
    for cand in python3 python; do
        p="$(command -v "$cand" 2>/dev/null)" || continue
        if "$p" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
            PY="$p"
            break
        fi
    done
fi
if [ -z "$PY" ]; then
    sys_py="$(command -v python3 || command -v python || true)"
    if [ -n "$sys_py" ]; then
        ver="$("$sys_py" -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null || echo '?')"
        echo "pre-push: repo requires Python 3.11+ to run the leak guard; found $ver at $sys_py." >&2
    else
        echo "pre-push: repo requires Python 3.11+ to run the leak guard; no python interpreter found." >&2
    fi
    echo "pre-push: create a .venv (python3.11 -m venv .venv) or point the hook at a 3.11+ interpreter." >&2
    exit 1
fi
# The guard decides for itself whether it is ARMED (a real config.yaml identity or
# $JOBHUNT_PERSONAL_TOKENS) and exits 2 if it is not — private/leak_tokens.txt
# alone does NOT arm it, which is why this hook no longer probes for those files.
# An unarmed guard cannot see the owner's name/email/handles, so pushing to a
# destination we could not prove private is a HARD STOP here: --allow-unarmed is
# deliberately NOT passed at push time.
if "$PY" automation/publish/check_public.py; then
    echo "pre-push: leak guard PASSED."
    echo "pre-push: OK"
else
    rc=$?
    if [ "$rc" = "2" ]; then
        echo "pre-push: REFUSING push — the leak guard is UNARMED (zero identity tokens)," >&2
        echo "pre-push: so its personal-token scan inspected nothing. See the report above" >&2
        echo "pre-push: for which config it looked for and where." >&2
        echo "pre-push: arm it (config.yaml / JOBHUNT_PERSONAL_TOKENS) and push again." >&2
    else
        echo "pre-push: REFUSING push — leak guard found violations in the tracked tree." >&2
        echo "pre-push: fix them before pushing." >&2
    fi
    # The next line is addressed to the REPO OWNER at a terminal. An agent that reads it
    # in a failed push must NOT act on it — see the JOBHUNT_ALLOW_PUSH note in the header.
    echo "pre-push: override knowingly with JOBHUNT_ALLOW_PUSH=1 (it skips BOTH checks)." >&2
    exit 1
fi
