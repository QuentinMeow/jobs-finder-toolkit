# Python
__pycache__/
*.pyc
.venv/
# Scratch
local/
# Local machine config (copy config.example.yaml -> config.yaml and edit)
config.yaml
# Local Claude Code settings (personal permissions + opt-in metrics hooks; see docs/handbook/metrics.md)
.claude/settings.local.json
# Local metrics collection output (opt-in metrics hooks; see docs/handbook/metrics.md)
logs/
# Cross-session scratch memory (ephemeral; see AGENTS.md Memory Map)
.cursor/MEMORY.md
# Private overlay (personal data mounts here; never committed to the public repo).
private/
# Agent scratch memory (personal cross-session notes; see AGENTS.md "Memory Map")
.agents/MEMORY.md
# Runtime entries for the PRIVATE skills, created by automation/bootstrap_overlay.py.
# They point straight at private/skills/<name> so the agent runtime lists them
# alongside the public ones; nothing private is placed under skills/ itself.
# (The tracked entries in these same directories -> ../../skills/<name> are the
# PUBLIC skills, generated by automation/publish/sync_skill_manifests.py.)
# Adding a private skill? Add its two lines here — bootstrap_overlay warns if you
# forget. Its content is denied a second time by check_public._DENY_TREES.
/.claude/skills/coding-interview
/.claude/skills/coding-interview-cleanup
/.cursor/skills/coding-interview
/.cursor/skills/coding-interview-cleanup
# NOTE (workspace-restructure phase 4, 2026-07-28): every rule that used to hide
# overlay content sitting at a path under skills/ is gone — the private-skill
# symlink and in-place rules, the personal search-profile glob with its two
# negations, and the per-skill private-notes pair. Nothing under skills/ is
# private any more; the overlay is reached through config accessors and the
# runtime entries above. A gitignore glob was never the guard anyway: `git add -f`
# overrode all of them. check_public.py is.
# Optional git-ignored personal token list consumed by the leak guard
private/leak_tokens.txt
# Private products (present only if you work in-place with your own data).
# Anchored to the repo root so they never match the tracked examples/ dataset
# (e.g. examples/applications/**, examples/templates/reference.example.docx).
# NOTE: the former /templates/ in-place rule was retired 2026-07-22 — root
# templates/ is now the TRACKED process-file schema folder; in-place resume
# reference DOCX belongs under private/ (see docs/handbook/private-overlay.md).
/applications/
/interviews/
/.agents/inputs/
# Generated dated discovery reports under the EXAMPLE config (test/canary runs
# write real dated files here because config.example.yaml points discoveries_dir
# at this tracked dir). Only .gitkeep is meant to be tracked.
examples/applications/1_discoveries/*.md
